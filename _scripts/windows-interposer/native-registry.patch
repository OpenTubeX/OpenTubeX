+static std::wstring NativePathToWin32(std::wstring path)
+{
+    path = ToUpper(std::move(path));
+
+    static const struct { const wchar_t* nt; const wchar_t* win32; } mappings[] = {
+        { L"\\REGISTRY\\MACHINE", L"HKEY_LOCAL_MACHINE"  },
+        { L"\\REGISTRY\\USER",    L"HKEY_USERS"          },
+        { L"\\REGISTRY\\CONFIG",  L"HKEY_CURRENT_CONFIG" },
+    };
+
+    for (const auto& mapping : mappings)
+    {
+        size_t prefixLength = wcslen(mapping.nt);
+        if (path.size() >= prefixLength &&
+            path.compare(0, prefixLength, mapping.nt) == 0 &&
+            (path.size() == prefixLength || path[prefixLength] == L'\\'))
+        {
+            std::wstring result = mapping.win32;
+            if (path.size() > prefixLength)
+                result += path.substr(prefixLength);
+            return NormalizeVirtualStore(std::move(result));
+        }
+    }
+
+    return NormalizeVirtualStore(std::move(path));
+}
+
+static std::wstring BuildNativePath(POBJECT_ATTRIBUTES attributes)
+{
+    if (!attributes || !attributes->ObjectName ||
+        !attributes->ObjectName->Buffer || attributes->ObjectName->Length == 0)
+        return {};
+
+    std::wstring name(attributes->ObjectName->Buffer,
+        attributes->ObjectName->Length / sizeof(wchar_t));
+    if (name.front() == L'\\')
+        return NativePathToWin32(std::move(name));
+
+    std::wstring base = GetAnyPathFull(reinterpret_cast<HKEY>(attributes->RootDirectory));
+    if (base.empty())
+        return {};
+    if (!name.empty())
+    {
+        base += L'\\';
+        base += name;
+    }
+    return NormalizeVirtualStore(ToUpper(std::move(base)));
+}
