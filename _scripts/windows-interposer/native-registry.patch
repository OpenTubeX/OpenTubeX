+static NTSTATUS NTAPI HookNtCreateKey(PHANDLE keyHandle, ACCESS_MASK desiredAccess,
+    POBJECT_ATTRIBUTES objectAttributes, ULONG titleIndex, PUNICODE_STRING keyClass,
+    ULONG createOptions, PULONG disposition)
+{
+    std::wstring path = BuildNativePath(objectAttributes);
+    if (path.empty() || !InVirtualSpace(path))
+        return g_origNtCreateKey(keyHandle, desiredAccess, objectAttributes, titleIndex,
+            keyClass, createOptions, disposition);
+
+    ULONG resultDisposition;
+    {
+        std::unique_lock lock(g_storeMutex);
+        bool existed = g_store.count(path) > 0;
+        g_store.emplace(path, ValueMap{});
+        g_dirty = true;
+        resultDisposition = existed ? REG_OPENED_EXISTING_KEY : REG_CREATED_NEW_KEY;
+    }
+
+    if (keyHandle)
+        *keyHandle = reinterpret_cast<HANDLE>(NewVirtHandle(path));
+    if (disposition)
+        *disposition = resultDisposition;
+    SaveRegFile();
+    return 0;
+}
+
+static NTSTATUS NTAPI HookNtSetValueKey(HANDLE keyHandle, PUNICODE_STRING valueName,
+    ULONG titleIndex, ULONG type, PVOID data, ULONG dataSize)
+{
+    if (IsDeletedVirtHandle(reinterpret_cast<HKEY>(keyHandle)))
+        return static_cast<NTSTATUS>(0xC000017CUL);
+
+    std::wstring path = GetAnyPathFull(reinterpret_cast<HKEY>(keyHandle));
+    if (path.empty() || !InVirtualSpace(path))
+        return g_origNtSetValueKey(keyHandle, valueName, titleIndex, type, data, dataSize);
+
+    RegValue value{ type, {} };
+    if (data && dataSize > 0)
+    {
+        const BYTE* bytes = static_cast<const BYTE*>(data);
+        value.data.assign(bytes, bytes + dataSize);
+    }
+    {
+        std::unique_lock lock(g_storeMutex);
+        g_store[path][NativeValueName(valueName)] = std::move(value);
+        g_dirty = true;
+    }
+    SaveRegFile();
+    return 0;
+}
+
+static NTSTATUS NTAPI HookNtDeleteValueKey(HANDLE keyHandle, PUNICODE_STRING valueName)
+{
+    std::wstring path = GetAnyPathFull(reinterpret_cast<HKEY>(keyHandle));
+    if (path.empty() || !InVirtualSpace(path))
+        return g_origNtDeleteValueKey(keyHandle, valueName);
+
+    bool removed;
+    {
+        std::unique_lock lock(g_storeMutex);
+        auto key = g_store.find(path);
+        removed = key != g_store.end() &&
+            key->second.erase(NativeValueName(valueName)) > 0;
+        g_dirty = g_dirty || removed;
+    }
+    if (!removed) return static_cast<NTSTATUS>(0xC0000034UL);
+    SaveRegFile();
+    return 0;
+}
+
+static NTSTATUS NTAPI HookNtDeleteKey(HANDLE keyHandle)
+{
+    if (IsDeletedVirtHandle(reinterpret_cast<HKEY>(keyHandle)))
+        return static_cast<NTSTATUS>(0xC000017CUL);
+
+    std::wstring path = GetAnyPathFull(reinterpret_cast<HKEY>(keyHandle));
+    if (path.empty() || !InVirtualSpace(path))
+        return g_origNtDeleteKey(keyHandle);
+
+    bool removed;
+    {
+        std::unique_lock lock(g_storeMutex);
+        auto key = g_store.find(path);
+        if (key == g_store.end())
+            return static_cast<NTSTATUS>(0xC0000034UL);
+
+        for (auto it = std::next(key); it != g_store.end(); ++it)
+        {
+            bool isDescendant = it->first.size() > path.size() &&
+                it->first.compare(0, path.size(), path) == 0 &&
+                it->first[path.size()] == L'\\';
+            if (!isDescendant)
+                break;
+            return static_cast<NTSTATUS>(0xC0000121UL);
+        }
+
+        removed = g_store.erase(path) > 0;
+        g_dirty = g_dirty || removed;
+    }
+    MarkVirtHandlesDeleted(path);
+    SaveRegFile();
+    return 0;
+}
+
+static NTSTATUS NTAPI HookNtSetInformationKey(HANDLE keyHandle, ULONG informationClass,
+    PVOID information, ULONG informationLength)
+{
+    std::wstring path = GetAnyPathFull(reinterpret_cast<HKEY>(keyHandle));
+    if (!path.empty() && InVirtualSpace(path))
+        return 0;
+    return g_origNtSetInformationKey(keyHandle, informationClass, information,
+        informationLength);
+}
+
+static NTSTATUS NTAPI HookNtFlushKey(HANDLE keyHandle)
+{
+    std::wstring path = GetAnyPathFull(reinterpret_cast<HKEY>(keyHandle));
+    if (!path.empty() && InVirtualSpace(path))
+    {
+        if (g_dirty)
+            SaveRegFile();
+        return 0;
+    }
+    return g_origNtFlushKey(keyHandle);
+}
+
+static NTSTATUS NTAPI HookNtSetSecurityObject(HANDLE handle,
+    SECURITY_INFORMATION securityInformation, PSECURITY_DESCRIPTOR securityDescriptor)
+{
+    std::wstring path = GetAnyPathFull(reinterpret_cast<HKEY>(handle));
+    if (!path.empty() && InVirtualSpace(path))
+        return 0;
+    return g_origNtSetSecurityObject(handle, securityInformation, securityDescriptor);
+}
+
+static NTSTATUS NTAPI HookNtClose(HANDLE handle)
+{
+    if (CloseVirtHandle(reinterpret_cast<HKEY>(handle)))
+        return 0;
+    UntrackRealHandle(reinterpret_cast<HKEY>(handle));
+    return g_origNtClose(handle);
+}
 
