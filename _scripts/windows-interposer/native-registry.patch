+static std::wstring NativeValueName(PUNICODE_STRING valueName)
+{
+    if (!valueName || !valueName->Buffer || valueName->Length == 0)
+        return {};
+    return ToUpper(std::wstring(valueName->Buffer,
+        valueName->Length / sizeof(wchar_t)));
