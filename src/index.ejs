<!DOCTYPE html>
<!-- Desktop and web replace the native page scrollbar with a drawn overlay one.
     Capacitor keeps Android's native page scrollbar. -->
<html<% if (!process.env.IS_CAPACITOR) { %> data-overlayscrollbars-initialize<% } %>>

  <head>
    <meta charset="utf-8" />
    <!-- Electron's app:// handler sends this policy with frame-ancestors as a header.
         Only the app's own files may run script. Its workers compile WebAssembly,
         and browsers that apply this policy to them need wasm-unsafe-eval.
         qr-scanner starts its worker from a blob: URL, which only script that
         already runs can create.
         Development builds wrap each module in eval() for source maps.
         On WebViews without document-start scripts, Capacitor inserts its
         Android bridge as an inline script right after a literal <head>, ahead
         of this tag, so keep <head> without attributes. -->
    <meta http-equiv="Content-Security-Policy"
          content="object-src 'none'; base-uri 'self'; form-action 'none'; script-src 'self' 'wasm-unsafe-eval'<% if (process.env.NODE_ENV === 'development') { %> 'unsafe-eval'<% } %>; worker-src 'self' blob:" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <% if (!process.env.IS_ELECTRON && !process.env.IS_CAPACITOR) { %>
    <link rel="manifest" href="static/manifest.json" />
    <!-- Without it, browsers request /favicon.ico, which a self-hosted server passes to Invidious -->
    <link rel="icon" href="icon.svg" type="image/svg+xml" />
    <!-- Keeps the server's address from other services, like SponsorBlock -->
    <meta name="referrer" content="no-referrer" />
    <% } %>
    <title></title>
    <% if (typeof startupSplash !== 'undefined') { %>
    <style><%= startupSplash.styles %></style>
    <!-- Before the injected stylesheet, which a later script would wait for -->
    <script src="boot.js"></script>
    <% } %>
  </head>

  <body>
    <div id="app"<% if (typeof startupSplash !== 'undefined') { %> inert<% } %>></div>
    <% if (typeof startupSplash !== 'undefined') { %>
    <div id="startup-splash" class="startupSplash" role="status" aria-label="OpenTubeX" aria-busy="true">
      <div class="startupShape" aria-hidden="true"><%= startupSplash.logo %></div>
      <div class="startupProgress" aria-hidden="true"><div class="startupIndicator"><span><svg class="startupWave" width="120" height="12"><path d="M-6 6Q0 0 6 6T18 6T30 6T42 6T54 6T66 6T78 6T90 6T102 6T114 6T126 6"/></svg></span></div></div>
    </div>
    <% } %>
    <% if (typeof selfHosted !== 'undefined' && selfHosted) { %>
    <!-- The server's settings, which the app reads when it starts -->
    <script src="self-hosted.js"></script>
    <% } %>
    <% if (!process.env.IS_ELECTRON && !process.env.IS_CAPACITOR) { %>
    <!-- Each build registers its own worker version, which replaces the previous build's cache -->
    <script src="register-service-worker.js" data-version="<%= compilation.hash %>"></script>
    <% } %>
    <!-- Rspack builds are automatically injected -->
  </body>

</html>
