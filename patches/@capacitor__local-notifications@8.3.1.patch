+    /** Queues a dismissal until a loaded plugin reports it. */
+    fun appendDismissal(data: JSObject) {
+        synchronized(DISMISSAL_LOCK) {
+            val queued = readDismissals()
+            queued.put(data)
+            getStorage(DISMISSAL_STORE_ID).edit().putString(DISMISSAL_KEY, queued.toString()).commit()
+        }
+    }
+
+    /** Returns and clears the queued dismissals, oldest first. */
+    fun takeDismissals(): List<JSObject> {
+        synchronized(DISMISSAL_LOCK) {
+            val queued = readDismissals()
+            if (queued.length() > 0) getStorage(DISMISSAL_STORE_ID).edit().remove(DISMISSAL_KEY).commit()
+            return (0 until queued.length()).mapNotNull { index ->
+                queued.optJSONObject(index)?.let { item -> try { JSObject(item.toString()) } catch (ex: JSONException) { null } }
+            }
+        }
+    }
+
+    private fun readDismissals(): JSONArray = try {
+        JSONArray(getStorage(DISMISSAL_STORE_ID).getString(DISMISSAL_KEY, null) ?: "[]")
+    } catch (ex: JSONException) {
+        JSONArray()
+    }
+
     companion object {
         private const val NOTIFICATION_STORE_ID = "NOTIFICATION_STORE"
         private const val ACTION_TYPES_ID = "ACTION_TYPE_STORE"
+        private const val DISMISSAL_STORE_ID = "NOTIFICATION_DISMISSAL_STORE"
+        private const val DISMISSAL_KEY = "dismissals"
+        private val DISMISSAL_LOCK = Any()
     }
