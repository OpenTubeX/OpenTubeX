+import { YTNode } from '../helpers.js';
+import { Parser } from '../index.js';
+import ButtonView from './ButtonView.js';
+import ShoppingContentLineView from './ShoppingContentLineView.js';
+import RendererContext from './misc/RendererContext.js';
+export default class ShoppingTimelyShelfContentView extends YTNode {
+    static type = 'ShoppingTimelyShelfContentView';
+    image;
+    line_1;
+    line_2;
+    buttons;
+    padding;
+    background_color;
+    renderer_context;
+    constructor(data) {
+        super();
+        this.image = data.image;
+        this.line_1 = Parser.parseItem(data.line1, ShoppingContentLineView);
+        this.line_2 = Parser.parseItem(data.line2, ShoppingContentLineView);
+        this.buttons = Parser.parseArray(data.button, ButtonView);
+        this.padding = data.padding;
+        this.background_color = data.backgroundColor;
+        if ('rendererContext' in data) {
+            this.renderer_context = new RendererContext(data.rendererContext);
+        }
+    }
+}
