new file mode 100644
index 0000000..45748bd
--- /dev/null
+++ b/dist/src/parser/classes/ShoppingTimelyShelfView.js
@@ -0,0 +1,32 @@
+import { YTNode } from '../helpers.js';
+import { Parser } from '../index.js';
+import NavigationEndpoint from './NavigationEndpoint.js';
+import ShoppingTimelyShelfContentView from './ShoppingTimelyShelfContentView.js';
+export default class ShoppingTimelyShelfView extends YTNode {
+    static type = 'ShoppingTimelyShelfView';
+    offer_id_to_variants;
+    cue_ranges;
+    constructor(data) {
+        super();
+        this.offer_id_to_variants = data.offerIdToVariants.map((item) => ({
+            key: item.key,
+            value: {
+                shelf: Parser.parseItem(item.value.shelf, ShoppingTimelyShelfContentView)
+            }
+        }));
+        this.cue_ranges = data.cueRanges.map((item) => ({
+            id: item.id,
+            start_time: {
+                seconds: item.startTime.seconds
+            },
+            end_time: {
+                seconds: item.endTime.seconds,
+                nanos: item.endTime.nanos
+            },
+            on_enter: {
+                click_tracking_params: item.onEnter.clickTrackingParams,
+                shopping_timely_shelf_update_command: new NavigationEndpoint(item.onEnter.shoppingTimelyShelfUpdateCommand)
+            }
+        }));
+    }
+}
