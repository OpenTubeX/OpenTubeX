+    private void pruneImageFiles(@Nullable Uri activeUri) {
+        try {
+            File[] images = getContext().getCacheDir().listFiles(file ->
+                file.isFile() && file.getName().startsWith("capawesome-clipboard-") && file.getName().endsWith(".png")
+            );
+            if (images == null || images.length <= MAX_CACHED_IMAGES) return;
+            Arrays.sort(images, Comparator.comparingLong(File::lastModified).reversed());
+            String authority = getContext().getPackageName() + ".fileprovider";
+            // Reserve one slot for the active image, regardless of its age.
+            int remaining = MAX_CACHED_IMAGES - 1;
+            for (File image : images) {
+                if (FileProvider.getUriForFile(getContext(), authority, image).equals(activeUri)) continue;
+                if (remaining > 0) {
+                    remaining--;
+                } else {
+                    image.delete();
+                }
+            }
+        } catch (Exception ignored) {
+            // Cache cleanup must not turn a successful clipboard write into an error.
+        }
+    }
