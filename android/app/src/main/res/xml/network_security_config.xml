<?xml version="1.0" encoding="utf-8"?>
<!-- User-installed CAs let self-hosted servers behind a private CA work, as they
     do in the system browser. See AndroidManifest.xml for why cleartext is allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
