{
  "name": "opentubex",
  "productName": "OpenTubeX",
  "desktopName": "opentubex.desktop",
  "description": "A private YouTube client",
  "version": "0.37.0",
  "license": "AGPL-3.0-or-later",
  "main": "./dist/main.js",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "author": {
    "name": "OpenTubeX contributors",
    "email": "info@opentubex.org",
    "url": "https://github.com/OpenTubeX/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenTubeX/OpenTubeX.git"
  },
  "bugs": {
    "url": "https://github.com/OpenTubeX/OpenTubeX/issues"
  },
  "scripts": {
    "build": "pnpm run pack && pnpm run build-release",
    "build:arm64": "pnpm run pack && pnpm run build-release:arm64",
    "build:arm32": "pnpm run pack && pnpm run build-release:arm32",
    "build-release": "node _scripts/build.mjs",
    "build-release:arm64": "node _scripts/build.mjs arm64",
    "build-release:arm32": "node _scripts/build.mjs arm32",
    "clean": "node _scripts/clean.mjs",
    "debug": "node _scripts/dev-runner.js --remote-debug",
    "dev": "node _scripts/dev-runner.js",
    "dev:worktree": "node _scripts/dev-runner.js --worktree",
    "dev:web": "node _scripts/dev-runner.js --web",
    "get-instances": "node _scripts/getInstances.js",
    "get-regions": "node _scripts/getRegions.mjs",
    "generate-iconify-bundle": "node _scripts/generateIconifyBundle.mjs",
    "release-note-promo": "node _scripts/releaseNotePromo.mjs",
    "screenshots": "pnpm run test:e2e:pack && node _scripts/screenshots.mjs",
    "screenshots:android": "node _scripts/androidScreenshots.mjs",
    "lint-all": "pnpm run \"/^(lint|lint-json)$/\"",
    "lint": "pnpm run \"/^(eslint-lint|lint-style)$/\"",
    "lint-fix": "pnpm run \"/^(eslint-lint|lint-style)-fix$/\"",
    "eslint-lint": "eslint --config eslint.config.mjs \"src/**/*.js\" \"src/renderer/**/*.vue\" \"static/*.js\" \"_scripts/*.js\" \"_scripts/**/*.mjs\" \"e2e/**/*.mjs\"",
    "eslint-lint-fix": "eslint --config eslint.config.mjs --fix \"src/**/*.js\" \"src/renderer/**/*.vue\" \"static/*.js\" \"_scripts/*.js\" \"_scripts/**/*.mjs\" \"e2e/**/*.mjs\"",
    "lint-json": "eslint --config eslint.config.mjs \"static/**/*.json\"",
    "lint-style": "stylelint \"src/**/*.{css,scss}\"",
    "lint-style-fix": "stylelint --fix \"src/**/*.{css,scss}\"",
    "lint-yml": "eslint --config eslint.config.mjs \"**/*.yml\" \"**/*.yaml\"",
    "pack": "pnpm run \"/^pack:(main|renderer|preload|botGuardScript)$/\" && node _scripts/injectAllowedPaths.mjs",
    "pack:main": "webpack --mode=production --config-node-env=production --config _scripts/webpack.main.config.js",
    "pack:renderer": "webpack --mode=production --config-node-env=production --config _scripts/webpack.renderer.config.js",
    "pack:preload": "webpack --mode=production --config-node-env=production --config _scripts/webpack.preload.config.js",
    "pack:web": "webpack --mode=production --config-node-env=production --config _scripts/webpack.web.config.js",
    "pack:capacitor": "webpack --mode=production --config-node-env=production --config _scripts/webpack.capacitor.config.js",
    "pack:ios": "webpack --mode=production --config-node-env=production --config _scripts/webpack.ios.config.js",
    "capacitor:sync:android": "pnpm run pack:capacitor && cap sync android && node _scripts/prepareAndroid.mjs",
    "capacitor:sync:ios": "bash _scripts/setupIosYtDlp.sh && pnpm run pack:ios && cap sync ios && node _scripts/prepareIos.mjs",
    "pack:botGuardScript": "webpack --config _scripts/webpack.botGuardScript.config.js",
    "checkforbadtemplates": "node _scripts/findMissingTemplates.mjs",
    "test:e2e:pack": "pnpm run \"/^test:e2e:pack:(main|renderer|preload|botGuardScript)$/\" && node _scripts/injectAllowedPaths.mjs dist-e2e",
    "test:e2e:pack:main": "webpack --mode=production --config-node-env=production --config _scripts/webpack.main.config.js --output-path dist-e2e && node _scripts/windowsShare.mjs dist-e2e",
    "test:e2e:pack:renderer": "webpack --mode=production --config-node-env=production --config _scripts/webpack.renderer.config.js --output-path dist-e2e",
    "test:e2e:pack:preload": "webpack --mode=production --config-node-env=production --config _scripts/webpack.preload.config.js --output-path dist-e2e",
    "test:e2e:pack:botGuardScript": "webpack --config _scripts/webpack.botGuardScript.config.js --output-path dist-e2e",
    "test:e2e": "playwright test -c e2e/playwright.config.mjs",
    "test:e2e:offline": "playwright test -c e2e/playwright.config.mjs --project=offline --project=offline-95 --project=offline-125 --project=performance --project=browser",
    "test:e2e:browser": "playwright test -c e2e/playwright.config.mjs --project=browser",
    "test:e2e:network": "playwright test -c e2e/playwright.config.mjs --project=network",
    "test:performance": "node e2e/performance/compare.mjs",
    "test:mobile-performance": "node --test tests/android/mobile-performance.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "ci": "pnpm install --frozen-lockfile"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/screen-brightness": "^8.0.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-app-shortcuts": "^8.0.2",
    "@capawesome/capacitor-clipboard": "^0.1.2",
    "@capawesome/capacitor-screen-orientation": "^8.0.4",
    "@capawesome/capacitor-settings-launcher": "^0.1.2",
    "@capawesome/capacitor-volume": "^0.1.3",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/google-sans": "^5.3.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@hpke/core": "^1.9.0",
    "@iconify/vue": "^5.0.4",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@material/material-color-utilities": "^0.4.0",
    "@seald-io/nedb": "^4.1.2",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "@vot.js/core": "^3.2.0",
    "autolinker": "^4.1.5",
    "bgutils-js": "^4.0.3",
    "dbus-native": "^0.16.3",
    "dompurify": "^3.4.17",
    "eld": "^2.1.0",
    "fflate": "^0.8.3",
    "font-list": "^2.1.0",
    "googlevideo": "^4.1.1",
    "marked": "^18.1.1",
    "overlayscrollbars": "^2.16.0",
    "process": "^0.11.10",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "quickjs-emscripten-core": "^0.32.0",
    "sax": "^1.6.1",
    "shaka-player": "^5.3.0",
    "swiper": "^14.3.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-observe-visibility": "^2.0.0-alpha.1",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "vuex": "^4.1.0",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@double-great/stylelint-a11y": "^3.8.1",
    "@eslint/js": "^10.0.1",
    "@iconify-json/material-symbols": "^1.2.96",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify/utils": "^3.1.5",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@lezer/html": "^1.3.13",
    "@lezer/markdown": "^1.8.1",
    "@magda/tree-kill": "1.2.3",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "cssnano": "^9.9.0",
    "electron": "^43.8.3",
    "electron-builder": "^26.17.0",
    "entities": "^8.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.3.15",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unicorn": "^78.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "eslint-plugin-yml": "^3.9.0",
    "globals": "^17.13.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-raw": "^9.1.0",
    "html-webpack-plugin": "^5.6.8",
    "js-yaml": "^5.5.0",
    "lefthook": "^2.2.2",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-markdown": "^2.2.0",
    "micromark-extension-gfm": "^3.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "minimizer-webpack-plugin": "^5.13.1",
    "node-gyp": "^13.1.0",
    "postcss": "^8.5.31",
    "postcss-scss": "^4.0.9",
    "sass": "^1.105.2",
    "sass-loader": "^17.0.1",
    "srcset": "^5.0.3",
    "stylelint": "^17.16.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-high-performance-animation": "^2.0.0",
    "stylelint-use-logical-spec": "^5.0.1",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.2.0",
    "vfile": "^6.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-loader": "^17.4.2",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0",
    "yaml": "^2.9.1"
  }
}
